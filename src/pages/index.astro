---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/HomePage";

const title = "transle - Typed i18n for TypeScript and React";
const description =
  "A tiny TypeScript-first i18n toolkit focused on developer speed, low setup cost, split locale files, and typed keys.";

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "transle",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  description,
  url: "https://transle.vercel.app/",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <HomePage client:load />
</BaseLayout>
