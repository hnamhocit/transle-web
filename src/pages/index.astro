---
import { createI18n } from "@hnamhocit/transle";
import InViewMotion from "../components/InViewMotion";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "transle - Typed i18n for TypeScript and React";
const description =
  "A tiny TypeScript-first i18n toolkit with typed dot-path keys, locale persistence, fallback locale support, and a React hook entry.";

const packageName = "@hnamhocit/transle";
const installCommand = "npm install @hnamhocit/transle";
const reactInstallCommand = "npm install @hnamhocit/transle react";
const heroCopyCommand = `${installCommand}\n${reactInstallCommand}`;
const coreExample = `import { createI18n } from "@hnamhocit/transle";

const i18n = createI18n({
  defaultLocale: "en",
  fallbackLocale: "en",
  persist: true,
  messages: {
    en: { hero: { title: "Hello {name}" } },
    vi: { hero: { title: "Xin chao {name}" } }
  }
});

i18n.t("hero.title", { name: "Nam" });`;

const reactExample = `import { createI18n } from "@hnamhocit/transle/react";

const useI18n = createI18n({
  defaultLocale: "en",
  persist: true,
  messages: {
    en: { common: { hello: "Hello {name}" } },
    vi: { common: { hello: "Xin chao {name}" } }
  }
});

export function Greeting() {
  const i18n = useI18n();
  return <p>{i18n.t("common.hello", { name: "Nam" })}</p>;
}`;

const aiSkillPrompt = `You are implementing i18n with @hnamhocit/transle.

Rules:
- Use "@hnamhocit/transle" for vanilla JS/TS.
- Use "@hnamhocit/transle/react" for React.
- Keep messages nested and use dot-path keys.
- Define defaultLocale and prefer fallbackLocale.
- Use persist when locale should survive reloads.
- Keep the same key paths across locales.
- Do not add a heavier i18n framework unless asked.`;

function escapeHtml(input: string) {
  return input
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

function renderCode(code: string, type: "ts" | "bash" | "txt" = "ts") {
  const lines = escapeHtml(code).split("\n");

  return lines
    .map((line, index) => {
      let html = line;
      const stashed: string[] = [];

      function wrap(pattern: RegExp, className: string) {
        html = html.replace(pattern, (match) => {
          const token = `__TOK_${stashed.length}__`;
          stashed.push(`<span class="${className}">${match}</span>`);
          return token;
        });
      }

      if (type === "bash") {
        html = html.replace(/^(npm)(.*)$/u, (_, command, rest) => {
          const highlightedRest = rest.replace(
            /(@hnamhocit\/transle(?:\/react)?)/gu,
            '<span class="tok-string">$1</span>',
          );

          return `<span class="tok-cmd">${command}</span><span class="tok-base">${highlightedRest}</span>`;
        });
      }

      if (type === "txt") {
        wrap(/(@hnamhocit\/transle(?:\/react)?)/gu, "tok-string");
        wrap(/^(Rules:)/u, "tok-key");
      }

      if (type === "ts") {
        wrap(/("@hnamhocit\/transle(?:\/react)?")/gu, "tok-string");
        wrap(/("(?:[^"\\]|\\.)*")/gu, "tok-string");
        wrap(/\b(createI18n)\b/gu, "tok-fn");
        wrap(
          /\b(defaultLocale|fallbackLocale|persist|messages|hero|title|common|hello)\b/gu,
          "tok-prop",
        );
        wrap(/\b(import|const|export|function|return)\b/gu, "tok-key");
        wrap(/\b(true)\b/gu, "tok-num");
      }

      html = html.replace(/__TOK_(\d+)__/gu, (_, tokenIndex) => stashed[Number(tokenIndex)]);

      return `<span class="code-line"><span class="line-no">${index + 1}</span><span class="line-code">${html}</span></span>`;
    })
    .join("");
}

const i18n = createI18n({
  defaultLocale: "en",
  fallbackLocale: "en",
  persist: {
    key: "transle_demo_locale",
  },
  messages: {
    en: {
      hero: {
        summary: "{name} ships {count} locales with less code",
      },
    },
    vi: {
      hero: {
        summary: "{name} ship {count} ngon ngu voi it code hon",
      },
    },
  },
});

const locales = i18n.getLocales();
const englishSummary = i18n.t("hero.summary", { name: "transle", count: 2 });
i18n.setLocale("vi");
const vietnameseSummary = i18n.t("hero.summary", { name: "transle", count: 2 });
i18n.setLocale("en");

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "transle",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  description,
  url: "https://transle.dev/",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <main class="shell">
    <section class="hero">
      <InViewMotion className="hero-copy" client:load>
        <p class="eyebrow">Package</p>
        <div class="package-lockup">
          <h1>transle</h1>
          <p class="package-name">{packageName}</p>
        </div>
        <p class="lede">Typed i18n for TypeScript, vanilla JS, and React.</p>

        <div class="hero-meta">
          <span>core + react</span>
          <span>fallback locale</span>
          <span>persist</span>
          <span>{locales.join(" / ")}</span>
        </div>

        <div class="mini-terminal">
          <div class="mini-head">
            <span>install</span>
            <button class="copy-button" type="button" data-copy={heroCopyCommand}>
              Copy
            </button>
          </div>
          <pre class="editor compact"><code set:html={renderCode(`${installCommand}\n${reactInstallCommand}`, "bash")} /></pre>
        </div>

        <div class="cta-row">
          <a class="button primary" href="#quickstart">Quickstart</a>
          <a class="button ghost" href="#ai-skill">AI prompt</a>
        </div>
      </InViewMotion>

      <InViewMotion className="hero-panel" delay={0.08} client:load>
        <div class="panel-header">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span>core.ts</span>
          <button class="copy-button subtle" type="button" data-copy={coreExample}>Copy</button>
        </div>
        <pre class="editor"><code set:html={renderCode(coreExample)} /></pre>
      </InViewMotion>
    </section>

    <section class="bento" id="features">
      <InViewMotion className="card feature-main" client:visible>
        <p class="eyebrow">Why</p>
        <h2>Less setup. Clear API. Typed keys.</h2>
        <p>No routing layer, no giant config, no framework lock-in.</p>
      </InViewMotion>

      <InViewMotion className="card stat-card" delay={0.06} client:visible>
        <span class="metric-value">2</span>
        <h2>Exports</h2>
        <p>{packageName} and {packageName}/react</p>
      </InViewMotion>

      <InViewMotion className="card quote-card" delay={0.12} client:visible>
        <p class="quote">{englishSummary}</p>
        <p class="quote-sub">{vietnameseSummary}</p>
      </InViewMotion>

      <InViewMotion className="card tiny-card" delay={0.18} client:visible>
        <h3>Dot-path keys</h3>
        <p>`auth.signIn`, `common.hello`, `hero.title`.</p>
      </InViewMotion>

      <InViewMotion className="card tiny-card" delay={0.24} client:visible>
        <h3>Persist locale</h3>
        <p>Uses localStorage when `persist` is enabled.</p>
      </InViewMotion>
    </section>

    <section class="section" id="quickstart">
      <div class="section-heading">
        <p class="eyebrow">Quickstart</p>
        <h2>Copy and run.</h2>
      </div>

      <div class="split">
        <InViewMotion className="card code-card" client:visible>
          <div class="card-top">
            <h3>Install</h3>
            <button class="copy-button" type="button" data-copy={heroCopyCommand}>Copy</button>
          </div>
          <pre class="editor"><code set:html={renderCode(`${installCommand}\n${reactInstallCommand}`, "bash")} /></pre>
        </InViewMotion>

        <InViewMotion className="card code-card" delay={0.08} client:visible>
          <div class="card-top">
            <h3>React</h3>
            <button class="copy-button" type="button" data-copy={reactExample}>Copy</button>
          </div>
          <pre class="editor"><code set:html={renderCode(reactExample)} /></pre>
        </InViewMotion>
      </div>
    </section>

    <section class="section muted-section">
      <div class="section-heading">
        <p class="eyebrow">What you get</p>
        <h2>Useful runtime features, not marketing filler.</h2>
      </div>

      <div class="starter-grid">
        <InViewMotion className="card tiny-card" client:visible>
          <h3>Fallback locale</h3>
          <p>Missing keys can fall back to a safe default locale.</p>
        </InViewMotion>
        <InViewMotion className="card tiny-card" delay={0.06} client:visible>
          <h3>Locale persistence</h3>
          <p>Keep the selected language after reload with `persist`.</p>
        </InViewMotion>
        <InViewMotion className="card tiny-card" delay={0.12} client:visible>
          <h3>AI skill file</h3>
          <p>
            <a href="/skills/transle-agent-skill.md">/skills/transle-agent-skill.md</a>
          </p>
        </InViewMotion>
      </div>
    </section>

    <section class="section" id="ai-skill">
      <div class="section-heading">
        <p class="eyebrow">AI prompt</p>
        <h2>Copy this for agents.</h2>
      </div>

      <InViewMotion className="card code-card" client:visible>
        <div class="card-top">
          <h3>transle agent prompt</h3>
          <button class="copy-button" type="button" data-copy={aiSkillPrompt}>Copy</button>
        </div>
        <pre class="editor"><code set:html={renderCode(aiSkillPrompt, "txt")} /></pre>
      </InViewMotion>
    </section>
  </main>

  <script is:inline>
    const copyButtons = document.querySelectorAll("[data-copy]");

    for (const button of copyButtons) {
      button.addEventListener("click", async () => {
        const text = button.getAttribute("data-copy");
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const previous = button.textContent;
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = previous;
          }, 1200);
        } catch {
          button.textContent = "Failed";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1200);
        }
      });
    }
  </script>
</BaseLayout>
